# Kopieren nach .env  bzw. in Railway als Variables setzen
PORT=3000
# Zugangs-Token fuer Upload/Loeschen. Fuer lokalen LAN-Betrieb einfach leer lassen.
# WICHTIG: Fuer den Cloud-Betrieb unbedingt einen schwer zu ratenden Wert setzen!
UPLOAD_TOKEN=
# Wechsel-Intervall der Slideshow in Millisekunden
SLIDESHOW_INTERVAL_MS=6000
